{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "physics",
    "ball",
    "playfield",
    "walls",
    "flippers",
    "slingshots",
    "bumpers",
    "launcher",
    "nudge",
    "scoringZones",
    "targets",
    "targetBank"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixedStep",
        "maxFrameDelta",
        "gravity",
        "linearDamping",
        "collisionSubsteps",
        "rollingFriction"
      ],
      "properties": {
        "fixedStep": {
          "type": "number",
          "minimum": 0.004,
          "maximum": 0.02
        },
        "maxFrameDelta": {
          "type": "number",
          "minimum": 0.016,
          "maximum": 0.1
        },
        "gravity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          }
        },
        "linearDamping": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "collisionSubsteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rollingFriction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ball": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "restitution",
        "maxSpeed",
        "start",
        "initialVelocity"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0.04,
          "maximum": 0.2
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "maxSpeed": {
          "type": "number",
          "minimum": 1,
          "maximum": 25
        },
        "start": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          }
        },
        "initialVelocity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          }
        }
      }
    },
    "playfield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceY",
        "drain",
        "safetyBounds"
      ],
      "properties": {
        "surfaceY": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "drain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minX",
            "maxX",
            "z"
          ],
          "properties": {
            "minX": {
              "type": "number",
              "minimum": -3,
              "maximum": 0
            },
            "maxX": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "z": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "safetyBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minX",
            "maxX",
            "minZ",
            "maxZ"
          ],
          "properties": {
            "minX": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            },
            "maxX": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "minZ": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            },
            "maxZ": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "a",
          "b",
          "restitution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+$"
          },
          "a": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "b": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          }
        }
      }
    },
    "flippers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pivot",
          "length",
          "radius",
          "restAngleDeg",
          "activeAngleDeg",
          "speedDegPerSec",
          "returnSpeedDegPerSec",
          "restitution",
          "kick"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^[a-z0-9_-]+$"
          },
          "pivot": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "length": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 1.5
          },
          "radius": {
            "type": "number",
            "minimum": 0.04,
            "maximum": 0.3
          },
          "restAngleDeg": {
            "type": "number",
            "minimum": -180,
            "maximum": 360
          },
          "activeAngleDeg": {
            "type": "number",
            "minimum": -180,
            "maximum": 360
          },
          "speedDegPerSec": {
            "type": "number",
            "minimum": 60,
            "maximum": 1500
          },
          "returnSpeedDegPerSec": {
            "type": "number",
            "minimum": 60,
            "maximum": 1500
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "kick": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "slingshots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "a",
          "b",
          "restitution",
          "impulse",
          "cooldownMs",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^[a-z0-9_-]+$"
          },
          "a": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "b": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "impulse": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 8
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 20,
            "maximum": 1000
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        }
      }
    },
    "bumpers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "radius",
          "restitution",
          "impulse",
          "cooldownMs",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z0-9_-]+$"
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "radius": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 0.8
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "impulse": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 10
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 20,
            "maximum": 1000
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spawn",
        "direction",
        "minPower",
        "maxPower",
        "chargeTimeMs",
        "lane",
        "laneRestitution",
        "exitKick",
        "tapCharge"
      ],
      "properties": {
        "spawn": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          }
        },
        "direction": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "minPower": {
          "type": "number",
          "minimum": 1,
          "maximum": 15
        },
        "maxPower": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "chargeTimeMs": {
          "type": "integer",
          "minimum": 200,
          "maximum": 3000
        },
        "lane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minX",
            "maxX",
            "exitZ"
          ],
          "properties": {
            "minX": {
              "type": "number",
              "minimum": -3,
              "maximum": 3
            },
            "maxX": {
              "type": "number",
              "minimum": -3,
              "maximum": 3
            },
            "exitZ": {
              "type": "number",
              "minimum": -4,
              "maximum": 1
            }
          }
        },
        "laneRestitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.2
        },
        "exitKick": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -6,
            "maximum": 6
          }
        },
        "tapCharge": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.8
        }
      }
    },
    "nudge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impulse",
        "maxWarnings",
        "windowMs"
      ],
      "properties": {
        "impulse": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        },
        "maxWarnings": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "windowMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      }
    },
    "scoringZones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "radius",
          "rearmRadius",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9_-]+$"
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "radius": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
          },
          "rearmRadius": {
            "type": "number",
            "minimum": 0.06,
            "maximum": 1.5
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "width",
          "restitution",
          "minImpact",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z0-9_-]+$"
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -5,
              "maximum": 5
            }
          },
          "width": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "minImpact": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        }
      }
    },
    "targetBank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completionScore",
        "resetMs",
        "popupZ"
      ],
      "properties": {
        "completionScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "resetMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 10000
        },
        "popupZ": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        }
      }
    }
  }
}
