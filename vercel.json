{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cricket-pinball/stadium-prototype",
      "destination": "/cricket-pinball/stadium-prototype/index.html"
    },
    {
      "source": "/play",
      "destination": "/play/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/cricket-pinball",
      "destination": "/cricket-pinball/index.html"
    },
    {
      "source": "/cricket-pinball/play",
      "destination": "/cricket-pinball/play/index.html"
    },
    {
      "source": "/cricket-pinball/match/:matchId",
      "destination": "/cricket-pinball/play/index.html"
    },
    {
      "source": "/cricket-pinball/watch/:matchId",
      "destination": "/cricket-pinball/watch/index.html"
    },
    {
      "source": "/cricket-pinball/world-test",
      "destination": "/cricket-pinball/world-test/index.html"
    },
    {
      "source": "/cricket-pinball/admin",
      "destination": "/cricket-pinball/admin/index.html"
    }
  ]
}
